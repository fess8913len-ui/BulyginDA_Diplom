filebeat.inputs:
- type: log
  enabled: true
  paths:
    - /var/log/nginx/*.log
  fields:
    source: "{{ inventory_hostname }}"
    hostname: "{{ ansible_hostname }}"
  fields_under_root: true

output.logstash:
  hosts: ["{{ elk_ip }}:5044"]

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7